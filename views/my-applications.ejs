<%- include('./partials/header') %>

    <h2>My Applications</h2>

    <div class="card" style="padding: 0;">
        <% if (applications.length> 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Role</th>
                        <th>Applied On</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% applications.forEach(app=> { %>
                        <tr>
                            <td>
                                <%= app.Job && app.Job.Company ? app.Job.Company.name : 'Unknown' %>
                            </td>
                            <td>
                                <%= app.Job ? app.Job.title : 'Unknown' %>
                            </td>
                            <td>
                                <%= new Date(app.appliedAt).toLocaleDateString() %>
                            </td>
                            <td>
                                <span class="badge" style="<%= app.status === 'Selected' ? 'background: #dcfce7; color: #166534;' : 
                                          app.status === 'Rejected' ? 'background: #fee2e2; color: #991b1b;' : 
                                          'background: #e0e7ff; color: var(--primary);' %>">
                                    <%= app.status %>
                                </span>
                            </td>
                            <td>
                                <a href="/applications/<%= app.id %>" class="btn btn-secondary"
                                    style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Track</a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <div style="padding: 2rem;">
                    <p>You haven't applied to any jobs yet.</p>
                    <a href="/jobs" class="btn btn-primary">Browse Jobs</a>
                </div>
                <% } %>
    </div>

    <%- include('./partials/footer') %>