<%- include('./partials/header') %>

    <div style="max-width: 800px; margin: 2rem auto;">
        <div class="card">
            <h2>Create Job Opening</h2>
            <form action="/jobs/add" method="POST">
                <div class="grid" style="grid-template-columns: 1fr 1fr;">
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Company</label>
                        <select name="companyId" class="form-control" required>
                            <% companies.forEach(c=> { %>
                                <option value="<%= c.id %>">
                                    <%= c.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Job Title</label>
                        <input type="text" name="title" class="form-control" required
                            placeholder="e.g. Software Engineer">
                    </div>
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Description & Requirements</label>
                        <textarea name="description" class="form-control" rows="5"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Salary Package</label>
                        <input type="text" name="salary" class="form-control" placeholder="e.g. 8 LPA">
                    </div>
                    <div class="form-group">
                        <label>Minimum CGPA Required</label>
                        <input type="number" step="0.01" name="minCGPA" class="form-control" placeholder="e.g. 7.5">
                    </div>
                    <div class="form-group">
                        <label>Eligible Branches (comma separated)</label>
                        <input type="text" name="eligibleBranches" class="form-control"
                            placeholder="e.g. CSE, IT, AI&DS">
                    </div>
                    <div class="form-group">
                        <label>Application Deadline</label>
                        <input type="date" name="deadline" class="form-control">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Publish Job</button>
            </form>
        </div>
    </div>

    <%- include('./partials/footer') %>